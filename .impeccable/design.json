  "narrative": {
    "northStar": "Tackle Twill",
    "overview": "RosterFit is drawn in the loaded team's uniform. Every player on screen wears his real jersey number as layered tackle twill in that team's colorway, so a five-man unit reads the way a coach reads his floor: numbers at their spots, not anonymous name rows. The page itself is the home-white jersey: a warm off-white ground with a faint dot mesh, a shell bar in the team's primary with a two-row running stitch in its secondary along its hem.\n\nEverything else stays quiet so the numbers can talk. The analysis surfaces are flat white panels with hairline rules, tabular figures and a box-score stat line. Data has its own palette that never borrows team color, so a Lakers gold and a Warriors gold never get confused with \"above average\". Density is that of a daily tool: tables that fit their column, a sticky half court beside them, no hero, no marketing rhythm. Motion only marks a state change: a swapped player glides to his spot and has his numeral re-stitched.",
    "keyCharacteristics": [
      "Real jersey numbers as three-layer SVG twill (fill, inner outline in the primary, outer outline in the secondary, a dashed sewing line between them at court and card sizes).",
      "Team colorway is runtime and scoped to identity: shell bar, wordmark, numerals. Never data.",
      "Home-white mesh ground (#f5f4ef plus a 3.5% dot weave), white surfaces, 3px corners.",
      "Box-score typography: Archivo for UI, Archivo Narrow uppercase for labels, Graduate block for numerals and the wordmark, tabular figures everywhere.",
      "Every headline number has an explanation one click away (a help button or an evidence link)."
    ],
    "rules": [
      {
        "name": "The Uniform Is Identity Rule",
        "body": "Team color dresses the shell bar, the wordmark and the numerals. It never encodes a value, a status or a selection tint stronger than 9%.",
        "section": "colors"
      },
      {
        "name": "The Two-Direction Data Rule",
        "body": "Warm means above average or helps, cool means below average or hurts, slate means neither. One fixed scale per comparison, centered on league average.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number is set in tabular figures (`font-feature-settings: \"tnum\"` on body), so columns and rolling counters never shift.",
        "section": "typography"
      },
      {
        "name": "The Numerals Only Rule",
        "body": "Graduate is reserved for jersey numbers and the wordmark. Headings and figures stay in Archivo.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Panels, cards and tables never carry a shadow; they are separated by a 1px rule-soft border on white.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show players as their real jersey numbers in the selected team's colorway wherever a lineup appears.",
      "Do keep data colors fixed (hot, cold, slate) and independent of the team.",
      "Do put an explanation one click from every headline number: a help button or an evidence link.",
      "Do keep motion to state feedback under 300ms on the strong ease-out or ease-in-out curves, transforms and opacity only, and drop it under reduced motion.",
      "Do gate hover styles to `(hover: hover) and (pointer: fine)` and keep touch targets at 44px."
    ],
    "donts": [
      "Don't use team color to encode a value, a direction or a status.",
      "Don't add shadows to panels, cards or tables.",
      "Don't use Graduate for headings or figures.",
      "Don't use purple-to-blue gradients, gradient text, glassmorphism, colored-border cards, grain over gradients, emojis in headings, Inter, or Lucide icons.",
      "Don't put a badge or eyebrow above a headline, or set three icon boxes in a row.",
      "Don't fade sections in on scroll, add a cursor beam, or make buttons fade on hover.",
      "Don't use em dashes or buzzwords in interface copy."
    ]
  }
}